# macOS
.DS_Store
**/.DS_Store

# Editor / tooling backup files
*.bak
*.bak.*
*.checkpoint
*.checkpoint-*
*.bak2

# Duplicate-artefact accidents
gradlew 2

# Local code-index tooling. The index and its model cache are this machine's
# working state, not the product, and .fastembed_cache is a symlink out to
# ~/.codanna/models that would commit as a broken link on anyone else's clone.
GURUbeta-FULL/.codanna/
GURUbeta-FULL/.fastembed_cache
GURUbeta-FULL/.codannaignore

# Working documents, not product. These are plans, drafts, audits and brain
# dumps written while building. They belong on this machine and must never
# reach the public repo, which is where customers and contributors look.
/BUG_WORKFLOW.md
/HEARTBEAT_ALARM_PLAN.md
/MEDIA_MODULE_PLAN.md
/MODULE_SYSTEM_PLAN.md
/KNOWLEDGE_GRAPH.md
/ONBOARDING_COPY_WORKSHEET.md
/ONBOARDING_FLOW.md
/ONBOARDING_QUESTIONS_MASTER.md
/ONBOARDING_TEXT_AUDIT.md
GURUbeta-FULL/BUG_WORKFLOW.md
GURUbeta-FULL/HEARTBEAT_ALARM_PLAN.md
GURUbeta-FULL/MEDIA_MODULE_PLAN.md
GURUbeta-FULL/MODULE_SYSTEM_PLAN.md