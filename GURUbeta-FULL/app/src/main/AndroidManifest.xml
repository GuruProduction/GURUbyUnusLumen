    <application
        android:name=".GuruApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:extractNativeLibs="true"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.guru"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".presentation.main.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.guru"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.DEFAULT" />

                <data android:scheme="app" />
                <data android:host="com.unuslumen.app.guru.task_details" />
                <data android:host="com.unuslumen.app.guru.tasks" />
                <data android:host="com.unuslumen.app.guru.calendar" />
                <data android:host="com.unuslumen.app.guru.calendar_event_details" />
                <data android:host="com.unuslumen.app.guru.notes" />
                <data android:host="com.unuslumen.app.guru.note_details" />
            </intent-filter>

        </activity>

        <receiver
            android:name="com.unuslumen.app.notification.BootBroadcastReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.unuslumen.app.notification.AlarmReceiver"
            android:enabled="true" />
        <receiver
            android:name="com.unuslumen.app.notification.TaskActionButtonBroadcastReceiver"
            android:enabled="true" />

        <activity
            android:name="com.unuslumen.app.presentation.SaveBookmarkActivity"
            android:autoRemoveFromRecents="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter android:label="@string/save_bookmark">
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.unuslumen.app.presentation.AddTaskFromShareActivity"
            android:autoRemoveFromRecents="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter android:label="@string/add_to_tasks">
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.unuslumen.app.presentation.AddNoteFromShareActivity"
            android:autoRemoveFromRecents="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter android:label="@string/add_note">
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- The Add task tile in the quick settings -->
        <service
            android:name="com.unuslumen.app.presentation.AddTaskTileService"
            android:exported="true"
            android:icon="@drawable/ic_check"
            android:label="@string/add_task_to_guru"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Calendar widget-->
        <receiver
            android:name="com.unuslumen.app.widget.calendar.CalendarWidgetReceiver"
            android:enabled="@bool/glance_appwidget_available"
            android:exported="true"
            android:label="@string/calendar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/calendar_widget_info" />
        </receiver>

        <!-- Tasks widget-->
        <receiver
            android:name="com.unuslumen.app.widget.tasks.TasksWidgetReceiver"
            android:enabled="@bool/glance_appwidget_available"
            android:exported="false"
            android:label="@string/tasks">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tasks_widget_info" />
        </receiver>

        <receiver
            android:name="com.unuslumen.app.widget.tasks.CompleteTaskWidgetReceiver"
            android:enabled="@bool/glance_appwidget_available"
            android:exported="false" />

        <!-- Notes widget-->
        <receiver
            android:name="com.unuslumen.app.widget.notes.NotesWidgetReceiver"
            android:enabled="@bool/glance_appwidget_available"
            android:exported="false"
            android:label="@string/notes">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/notes_widget_info" />
        </receiver>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />

        <!-- Guru Accessibility Service for device control -->
        <service
            android:name="com.unuslumen.app.util.shell.GuruAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/guru_accessibility_service_config" />
        </service>

        <!-- Guru Floating Orb Service (chat head) -->
        <service
            android:name="com.unuslumen.app.util.orb.GuruOrbService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="com.unuslumen.app.guru.action.START_ORB" />
            </intent-filter>
        </service>

        <!-- Screen Capture Service (required for MediaProjection on Android 14+) -->
        <service
            android:name="com.unuslumen.app.util.service.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection">
        </service>

        <!-- Guru Notification Listener — lets Guru read and manage notifications -->
        <service
            android:name="com.unuslumen.app.data.tools.GuruNotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Tor daemon service (bundled tor-android) -->
        <service
            android:name="org.torproject.jni.TorService"
            android:exported="false" />

        <!-- Tor persistent foreground service — keeps Tor alive indefinitely.
             specialUse, not dataSync: Android 15+ imposes a ~6h runtime limit on
             dataSync services and throws ForegroundServiceDidNotStopInTimeException
             (killing the whole app) when the service refuses to stop. Tor runs for
             the device's entire uptime by design, so it must use specialUse. -->
        <service
            android:name="com.unuslumen.app.data.tor.TorPersistentService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Tor SOCKS proxy for private network access, required for the entire device uptime" />
        </service>

    </application>

</manifest>